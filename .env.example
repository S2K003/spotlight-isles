# Copy to .env.local (and add the same two variables in Vercel → Project → Settings → Environment Variables).
# Supabase → Project Settings → API. Only Realtime is used; no tables are created.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

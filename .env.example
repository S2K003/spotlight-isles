# Copy to .env.local (and add the same two variables in Vercel → Project → Settings → Environment Variables).
# Supabase → Project Settings → API. Only Realtime is used; no tables are created.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Newer Supabase projects show a "publishable" key (sb_publishable_...). Older ones show an "anon" key;
# for those you can use NEXT_PUBLIC_SUPABASE_ANON_KEY instead. Either name works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
